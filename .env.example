# Shared passcode gating all non-public routes (middleware). Required.
SCARA_PASSCODE=scara2026

# --- Phase 2+ (database) ---
# Leave TURSO_* unset in dev: a local SQLite file at .data/scara.db is used.
# In production (Vercel), set both to use Turso (libSQL) free tier.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# --- Phase 2+ (photo/file storage) ---
# Leave unset in dev: files go to data/uploads/ on local disk.
# In production, create a Cloudflare R2 bucket (free tier) and set all four.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=scara
